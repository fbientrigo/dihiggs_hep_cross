set group_subprocesses Auto
set ignore_six_quark_processes False
set low_mem_multicore_nlo_generation False
set complex_mass_scheme False
set include_lepton_initiated_processes False
set gauge unitary
set loop_optimized_output True
set loop_color_flows False
set max_npoint_for_channel 0
set default_unset_couplings 99
set max_t_for_channel 99
set zerowidth_tchannel True
set nlo_mixed_expansion True
import model /home/fabi/atlas_dihiggs/_worktrees/r11-madgraph-producti\
on-mode-pilot/results/r11_madgraph_production_pilot/ufo/pi_ufo_baselin\
e_v1_release_candidate_hotfix1/model/LLscalar_v3_UFO_runtime
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate g g > H > h2 h2
output /home/fabi/atlas_dihiggs/_worktrees/r11-madgraph-production-mod\
e-pilot/results/r11_madgraph_production_pilot/proc_output -f
